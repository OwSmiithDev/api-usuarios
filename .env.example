APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL (Async) — troque usuário/senha por valores fortes antes de subir.
# Gere a senha com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=api_prod
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE
POSTGRES_DB=api_usuarios
DATABASE_URL=postgresql+asyncpg://api_prod:TROQUE_POR_SENHA_FORTE@db:5432/api_usuarios
TEST_DATABASE_URL=

# Security — gere uma chave única e secreta (nunca reutilize a de exemplo):
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=TROQUE_POR_CHAVE_UNICA_LONGA
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Regras de Negócio
RAIO_VIZINHANCA=2

# Rate Limit e CORS
RATE_LIMIT_ENABLED=true
# Em produção, liste os domínios que podem chamar a API pelo navegador (separados por vírgula).
# Ex.: CORS_ORIGINS=https://meuapp.com,https://admin.meuapp.com
# Se for só consumir via curl/Postman/servidor, deixe vazio.
CORS_ORIGINS=
